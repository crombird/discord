{
  "name": "@crombird/discord",
  "type": "module",
  "scripts": {
    "start": "bun run src/start.ts",
    "release": "bun run src/scripts/release.ts",
    "graphql-codegen": "graphql-codegen --config codegen.ts",
    "generate-sites": "bun run src/scripts/generate-sites.ts",
    "formatjs-extract": "formatjs extract 'src/**/*.ts' --out-file messages/en-US.json --id-interpolation-pattern '[sha512:contenthash:base64:8]'",
    "formatjs-compile": "formatjs compile-folder --ast messages src/__generated__/messages",
    "formatjs-verify": "formatjs verify --missing-keys --extra-keys --structural-equality --source-locale en-US messages/*.json",
    "type-check": "tsgo",
    "lint": "eslint src/**/*.ts --no-warn-ignored && prettier --check .",
    "test": "bun test"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@formatjs/intl": "^4.1.2",
    "@sentry/bun": "^10.39.0",
    "date-fns": "^4.1.0",
    "discord-api-types": "^0.38.40",
    "discord-interactions": "^4.4.0",
    "match-sorter": "^8.3.0",
    "mnemonist": "^0.40.3",
    "p-limit": "^7.3.0",
    "prom-client": "^15.1.3",
    "typebox": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@formatjs/cli": "^6.13.0",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/typescript": "^5.0.8",
    "@graphql-codegen/typescript-operations": "^5.0.8",
    "@types/bun": "^1.3.9",
    "@typescript/native-preview": "^7.0.0-dev.20260221.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-formatjs": "^6.1.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
